# SuwaDaru environment example.
# Connected auth uses the following two public client values.
# Commit this file only. Real values belong in an untracked .env file.
#
# Never put a Gemini API key, a service-role key, or any other secret in a
# VITE_ variable. Vite embeds VITE_ values in the browser bundle.

# B1 only, after a security review. These are the publishable client values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do not prefix these with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY is used by the local/server AI endpoint. For the Edge Function:
#   supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
